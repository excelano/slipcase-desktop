<?xml version="1.0" encoding="UTF-8"?>
<!--
  The slipcase media type, for shared-mime-info.

  SPEC 4 names `application/x.slipcase+zip` and the extension `.slpc`, and it
  reserves no magic bytes: a container is identified by opening it and finding
  a conformant metadata member, which is not a question this database can ask.
  The glob is therefore the only identification available here.

  `sub-class-of application/zip` is true and useful. A container is a ZIP, so an
  archive tool can open one, and a desktop that knows nothing of slipcases still
  has something to offer. It does not cost the glob: where a name matches
  `*.slpc` and the content sniffs as `application/zip`, shared-mime-info takes
  the glob, because the magic-matched type is the parent rather than the child.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x.slipcase+zip">
    <comment>Slipcase container</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.slpc"/>
    <icon name="application-x.slipcase+zip"/>
    <!--
    Our own icon rather than `package-x-generic`, and the reason is a property
    of how GTK searches. GIO hands the file manager the whole name list at
    once, and GTK4 searches theme-major: it looks for every name in Adwaita
    before it looks for any name in hicolor. `package-x-generic` exists in
    Adwaita and this icon exists only in hicolor, so the generic won on every
    lookup regardless of the order here, and every container drew as a plain
    archive. Measured both ways — paired with a name that exists nowhere, this
    icon is found; paired with any name Adwaita carries, it is not. Naming the
    specific icon here leaves no name for Adwaita to answer, so hicolor is
    reached and the drawing appears.
    -->
    <generic-icon name="application-x.slipcase+zip"/>
  </mime-type>
</mime-info>
