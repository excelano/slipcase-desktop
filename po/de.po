#: src/lib.rs:420 src/lib.rs:564
msgid "{file} has a name that is not UTF-8, and content.file is a TOML string"
msgstr ""
"{file} hat einen Namen, der nicht UTF-8 ist, und content.file ist eine TOML-"
"Zeichenkette"

#: src/lib.rs:571
msgid "{name} cannot be a content file's name: {reason}"
msgstr "{name} kann kein Name einer Inhaltsdatei sein: {reason}"

#: src/lib.rs:642
msgid "{n} byte"
msgid_plural "{n} bytes"
msgstr[0] "{n} Byte"
msgstr[1] "{n} Bytes"

#: src/lib.rs:661
msgid "{size} {unit} ({n} bytes)"
msgstr "{size} {unit} ({n} Bytes)"

#: src/lib.rs:756
msgid "cannot be read: {reason}"
msgstr "kann nicht gelesen werden: {reason}"

#: src/main.rs:669 src/main.rs:1142
msgid "Open a container…"
msgstr "Container öffnen …"

#: src/main.rs:670 src/main.rs:1143
msgid "New container…"
msgstr "Neuer Container …"

#: src/main.rs:674
msgid "Save"
msgstr "Speichern"

#: src/main.rs:675 src/main.rs:1388
msgid "Undo"
msgstr "Rückgängig"

#: src/main.rs:676
msgid "Redo"
msgstr "Wiederholen"

#: src/main.rs:678
msgid "edited"
msgstr "geändert"

#: src/main.rs:707
msgid "Saved."
msgstr "Gespeichert."

#: src/main.rs:711
msgid "Nothing had changed, so nothing was written."
msgstr "Nichts hatte sich geändert, also wurde nichts geschrieben."

#: src/main.rs:716
msgid "Not saved. What was written did not read back conformant: {verdict}"
msgstr ""
"Nicht gespeichert. Das Geschriebene wurde nicht als konform zurückgelesen: "
"{verdict}"

#: src/main.rs:722
msgid "Not saved: {reason}"
msgstr "Nicht gespeichert: {reason}"

#: src/main.rs:764
msgid "the extraction stopped without saying why"
msgstr "das Entpacken wurde beendet, ohne einen Grund zu nennen"

#: src/main.rs:779
msgid "the container was not made, and nothing said why"
msgstr "der Container wurde nicht erstellt, und nichts nannte einen Grund"

#: src/main.rs:798
msgid "Made."
msgstr "Erstellt."

#: src/main.rs:808
msgid ""
"Made. Where the content file came from could not be carried onto it: {reason}"
msgstr ""
"Erstellt. Die Herkunft der Inhaltsdatei konnte nicht auf sie übertragen "
"werden: {reason}"

#: src/main.rs:817 src/main.rs:1412
msgid "Stopped. Nothing was left behind."
msgstr "Angehalten. Es blieb nichts zurück."

#: src/main.rs:850
msgid "Not made. What was written did not read back conformant: {verdict}"
msgstr ""
"Nicht erstellt. Das Geschriebene wurde nicht als konform zurückgelesen: "
"{verdict}"

#: src/main.rs:854
msgid "Not made: {reason}"
msgstr "Nicht erstellt: {reason}"

#: src/main.rs:905
msgid "{file} was extracted, and the system would not open it: {reason}"
msgstr ""
"{file} wurde entpackt, und das System wollte die Datei nicht öffnen: {reason}"

#: src/main.rs:993
msgid "Open a container"
msgstr "Einen Container öffnen"

#: src/main.rs:994 src/main.rs:1003
msgid "slipcases"
msgstr "Slipcase-Dateien"

#: src/main.rs:995 src/main.rs:1004
msgid "All files"
msgstr "Alle Dateien"

#: src/main.rs:998
msgid "Extract the content file to"
msgstr "Inhaltsdatei entpacken nach"

#: src/main.rs:999
msgid "Replace the content file with"
msgstr "Inhaltsdatei ersetzen durch"

#: src/main.rs:1000
msgid "Make a container out of"
msgstr "Container erstellen aus"

#: src/main.rs:1002
msgid "Write the container to"
msgstr "Container schreiben nach"

#: src/main.rs:1182
msgid "Open a container to see what is in it, or make one out of a file."
msgstr ""
"Einen Container öffnen, um zu sehen, was darin ist, oder einen aus einer "
"Datei erstellen."

#: src/main.rs:1239
msgid "Stop"
msgstr "Anhalten"

#: src/main.rs:1279
msgid "Opens with {application}"
msgstr "Wird geöffnet mit {application}"

#: src/main.rs:1286
msgid "Cannot be opened here: {reason}"
msgstr "Kann hier nicht geöffnet werden: {reason}"

#: src/main.rs:1302
msgid ""
"The content file is an executable file; the extracted copy will not be "
"executable."
msgstr ""
"Die Inhaltsdatei ist eine ausführbare Datei; die entpackte Kopie wird nicht "
"ausführbar sein."

#: src/main.rs:1318
msgid ""
"This container arrived from elsewhere, and the content file will carry that."
msgstr ""
"Dieser Container kam von anderswo, und die Inhaltsdatei trägt das weiter."

#: src/main.rs:1336
msgid "Cancel"
msgstr "Abbrechen"

#: src/main.rs:1343
msgid "Open"
msgstr "Öffnen"

#: src/main.rs:1344
msgid "Extract…"
msgstr "Entpacken …"

#: src/main.rs:1345
msgid "Replace…"
msgstr "Ersetzen …"

#: src/main.rs:1381
msgid "Will be replaced by {file} when this is saved."
msgstr "Wird beim Speichern durch {file} ersetzt."

#: src/main.rs:1402
msgid "Extracted to {file}"
msgstr "Entpackt nach {file}"

#: src/main.rs:1456
msgid "no temporary directory to extract into: {reason}"
msgstr "kein temporäres Verzeichnis zum Entpacken vorhanden: {reason}"

#: src/main.rs:1467
msgid "no temporary directory to extract into"
msgstr "kein temporäres Verzeichnis zum Entpacken vorhanden"
